{
  "name": "voice-partition-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "astryx": {
    "theme": "./src/theme/voice-partition.js"
  },
  "allowScripts": {
    "@astryxdesign/cli@0.4.7": true,
    "@astryxdesign/core@0.4.7": true,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "vite",
    "desktop": "electron_config_cache=/private/tmp/voice-partition-electron-cache electron .",
    "desktop:dev": "electron_config_cache=/private/tmp/voice-partition-electron-cache VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .",
    "build": "vite build && node scripts/verify-production-build.mjs",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.7",
    "@astryxdesign/theme-neutral": "^0.4.7",
    "@stylexjs/stylex": "^0.19.0",
    "@tosspayments/tosspayments-sdk": "^2.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.4.7",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.0.0",
    "gpt-tokenizer": "^3.4.0",
    "vite": "^7.3.6",
    "wrangler": "4.125.0"
  }
}
